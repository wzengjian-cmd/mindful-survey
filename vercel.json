{
  "version": 2,
  "builds": [
    {
      "src": "api/store-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/submit.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/data.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/store-data",
      "dest": "/api/store-data.js"
    },
    {
      "src": "/api/get-data",
      "dest": "/api/get-data.js"
    },
    {
      "src": "/submit",
      "dest": "/api/submit.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin-simple.html",
      "dest": "/admin-simple.html"
    },
    {
      "src": "/all-data-view.html",
      "dest": "/all-data-view.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin.html"
    },
    {
      "src": "/admin-fixed.html",
      "dest": "/admin-fixed.html"
    },
    {
      "src": "/view-data.html",
      "dest": "/view-data.html"
    },
    {
      "src": "/mobile-index.html",
      "dest": "/mobile-index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}